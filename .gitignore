# Xcode generated project — regenerate with `xcodegen generate`
*.xcodeproj/

# Xcode user state
xcuserdata/
*.pbxuser
!default.pbxuser
*.mode1v2
!default.mode1v2
*.mode2v2
!default.mode2v2
*.perspectivev3
!default.perspectivev3
*.xccheckout
*.xcscmblueprint

# Build
build/
DerivedData/
.build/
Products/

# SwiftData / SQLite runtime stores
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Bible translation JSON (never commit copyrighted text)
*.json
# But DO commit project config and the bundled public-domain WEB resource
!project.yml
!Resources/web-bible.json
!Resources/Assets.xcassets/**/*.json

# macOS
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# SwiftPM
Package.resolved

# CocoaPods (not used)
Pods/

# Carthage (not used)
Carthage/Build/

# Fastlane (not used)
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output
